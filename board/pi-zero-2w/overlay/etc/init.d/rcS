#!/bin/sh
# PiOS init script

PATH=/sbin:/bin:/usr/sbin:/usr/bin

# Mount proc/sys/dev
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mount -t tmpfs tmpfs /tmp

# Make device nodes
mkdir -p /dev/pts /dev/shm
mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /dev/shm

# Remount root RW for setup
mount -o remount,rw /

# Populate /run and /var
mkdir -p /run /var/log /var/tmp /var/cache

# Apply sysctl
sysctl -p /etc/sysctl.conf 2>/dev/null

# Set hostname
hostname pios

# Configure loopback
ip addr add 127.0.0.1/8 dev lo
ip link set lo up

# Mount boot partition
mount /dev/mmcblk0p1 /boot 2>/dev/null || true

# Mount data partition if exists
mkdir -p /data
mount /dev/mmcblk0p3 /data 2>/dev/null || true

# Resize rootfs on first boot if needed
if [ -f /etc/.resizefs ]; then
    echo "Resizing root filesystem..."
    resize2fs /dev/mmcblk0p2
    rm -f /etc/.resizefs
fi

# Setup zram swap
modprobe zram num_devices=1
echo zstd > /sys/block/zram0/comp_algorithm
echo 128M > /sys/block/zram0/disksize
mkswap /dev/zram0
swapon /dev/zram0 -p 100

# Start wireless
modprobe brcmfmac 2>/dev/null || true
sleep 1
wpa_supplicant -B -i wlan0 -c /etc/wpa_supplicant/wpa_supplicant.conf 2>/dev/null || true
udhcpc -i wlan0 -x hostname:pios -p /run/udhcpc.pid 2>/dev/null || true

# Sync time
ntpd -p pool.ntp.org 2>/dev/null || true

# CPU governor
if [ -f /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor ]; then
    echo ondemand > /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor
    echo 50 > /sys/devices/system/cpu/cpufreq/ondemand/up_threshold
    echo 10000 > /sys/devices/system/cpu/cpufreq/ondemand/sampling_rate
fi

# Disable cursor on framebuffer
echo 0 > /sys/class/graphics/fbcon/cursor_blink 2>/dev/null || true

# Start PiOS shell on tty1
# (handled by inittab)

echo "PiOS ready."
