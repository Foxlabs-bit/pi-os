# Kernel config fragment for Pi Zero 2 W - Minimal, optimized
# Applied on top of bcmrpi3_defconfig

# Power management - aggressive for battery/low power
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_IDLE=y
CONFIG_ARM_PSCI_CPUIDLE=y

# Memory
CONFIG_CMA=y
CONFIG_CMA_SIZE_MBYTES=64
CONFIG_ZSMALLOC=y
CONFIG_ZSWAP=y
CONFIG_ZSWAP_COMPRESSOR=zstd
CONFIG_ZSWAP_ZPOOL=zsmalloc

# Block layer
CONFIG_IOSCHED_BFQ=y
CONFIG_BFQ_GROUP_IOSCHED=y
CONFIG_BLK_DEV_THROTTLING=y

# Networking - keep essential only
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_USB=y
CONFIG_BRCMFMAC_SDIO=y

# DRM/VC4
CONFIG_DRM=y
CONFIG_DRM_VC4=y
CONFIG_DRM_VC4_HDMI_CEC=y
CONFIG_DRM_PANEL_ORIENTATION_QUIRKS=y

# Sound
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_BCM2835_SOC_I2S=y
CONFIG_SND_SOC_ADAU7002=y

# USB
CONFIG_USB_DWC2=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_ECM=y

# Disable debug to save space and CPU
CONFIG_DEBUG_KERNEL=n
CONFIG_DEBUG_FS=n
CONFIG_DYNAMIC_DEBUG=n
CONFIG_DEBUG_BUGVERBOSE=n
CONFIG_PRINTK_TIME=n

# Filesystems
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_COMPRESSION=y
CONFIG_NTFS_FS=y
CONFIG_NTFS_RW=y
CONFIG_EXFAT_FS=y
CONFIG_VFAT_FS=y

# Disable huge pages on 512MB system
CONFIG_TRANSPARENT_HUGEPAGE=n
CONFIG_HUGETLBFS=n
CONFIG_HUGETLB_PAGE=n

# Reduce slab merge overhead
CONFIG_SLAB_MERGE_DEFAULT=n

# Enable zram for swap
CONFIG_ZRAM=m
CONFIG_ZRAM_DEF_COMP_ZSTD=y
